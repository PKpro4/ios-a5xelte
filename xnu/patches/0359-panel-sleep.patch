diff --git a/bsd/dev/herolte_gl.c b/bsd/dev/herolte_gl.c
--- a/bsd/dev/herolte_gl.c
+++ b/bsd/dev/herolte_gl.c
@@ -4197,6 +4197,92 @@
 	}
 }
 
+/*
+ * (0359, S7) The panel asleep with the screen off. Until now "off" only faded the picture to black (0079): the
+ * S6E3HA3 stayed awake and the DSI link kept carrying frames. As Samsung's s6e3ha3_wqhd_exit / _init (decon_8890
+ * panels/s6e3ha3_s6e3ha2_wqhd_lcd_ctrl.c): DISPLAY_OFF (DCS 0x28), SLEEP_IN (0x10), 120 ms; back: SLEEP_OUT (0x11),
+ * 120 ms, DISPLAY_ON (0x29). Its power rails are left on (as in sleep the panel keeps its settings). Sent as DCS
+ * short writes (data id 0x05) through DSIM0 (0x13900000; regs-dsim.h: PKTHDR 0x3c, INTSRC 0x34, FIFOCTRL 0x4c bit
+ * 10 = header FIFO empty), as dsim_write_data does. Asleep 700 ms after "off" (after the fade), if still off; "on"
+ * waits here (up to 500 ms) until the panel is awake, before the first frame is drawn.
+ */
+static volatile int hp_want_off, hp_asleep;
+static vm_offset_t hp_dsim;
+
+static bool
+hp_dcs(uint8_t cmd)
+{
+	notefe_wr(hp_dsim, 0x34, 1u << 28);                          /* INTSRC: SFR_PH_FIFO_EMPTY cleared */
+	notefe_wr(hp_dsim, 0x3c, 0x05u | ((uint32_t)cmd << 8));      /* DCS short write, no parameter */
+	for (unsigned us = 0; us < 50000; us += 50) {
+		if (notefe_rd(hp_dsim, 0x4c) & (1u << 10)) {
+			return true;
+		}
+		delay(50);
+	}
+	printf("HEROLTE PANEL: DCS %#x not sent in 50 ms (FIFOCTRL %#x)\n", cmd, notefe_rd(hp_dsim, 0x4c));
+	return false;
+}
+
+static void
+hp_thread(__unused void *arg, __unused wait_result_t wr)
+{
+	for (;;) {
+		assert_wait_timeout((event_t)&hp_want_off, THREAD_UNINT, 1000, NSEC_PER_MSEC);
+		if (hp_want_off != hp_asleep) {
+			thread_wakeup((event_t)&hp_want_off);   /* changed meanwhile: don't sleep (no clear_wait in BSD) */
+		}
+		thread_block(THREAD_CONTINUE_NULL);
+		if (hp_want_off && !hp_asleep) {
+			delay_for_interval(700, NSEC_PER_MSEC);
+			if (!hp_want_off) {
+				continue;
+			}
+			bool a = hp_dcs(0x28), b = hp_dcs(0x10);
+			delay_for_interval(120, NSEC_PER_MSEC);
+			hp_asleep = 1;
+			printf("HEROLTE PANEL: asleep (display off %s, sleep in %s)\n", a ? "ok" : "FAILED", b ? "ok" : "FAILED");
+		} else if (!hp_want_off && hp_asleep) {
+			bool a = hp_dcs(0x11);
+			delay_for_interval(120, NSEC_PER_MSEC);
+			bool b = hp_dcs(0x29);
+			hp_asleep = 0;
+			thread_wakeup((event_t)&hp_asleep);
+			printf("HEROLTE PANEL: awake (sleep out %s, display on %s)\n", a ? "ok" : "FAILED", b ? "ok" : "FAILED");
+		}
+	}
+}
+
+void herolte_panel_power(bool off);
+void
+herolte_panel_power(bool off)
+{
+	static bool started, broken;
+	if (broken) {
+		return;
+	}
+	if (!started) {
+		thread_t th;
+		started = true;
+		hp_dsim = ml_io_map(0x13900000u, 0x1000);
+		if (!hp_dsim || kernel_thread_start(hp_thread, NULL, &th) != KERN_SUCCESS) {
+			printf("HEROLTE PANEL: no DSIM mapping or thread: the panel stays awake\n");
+			broken = true;
+			return;
+		}
+		thread_deallocate(th);
+	}
+	hp_want_off = off ? 1 : 0;
+	thread_wakeup((event_t)&hp_want_off);
+	for (unsigned ms = 0; !off && hp_asleep && ms < 500; ms += 20) {
+		assert_wait_timeout((event_t)&hp_asleep, THREAD_UNINT, 20, NSEC_PER_MSEC);
+		if (!hp_asleep) {
+			thread_wakeup((event_t)&hp_asleep);
+		}
+		thread_block(THREAD_CONTINUE_NULL);
+	}
+}
+
 static int
 notefe_cam_sysctl SYSCTL_HANDLER_ARGS
 {
