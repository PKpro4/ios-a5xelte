 	}
 }
 extern "C" volatile uint64_t herolte_screen_off_at;    /* bsd/dev/herolte_gpu.c (0330) */
+extern "C" void herolte_panel_power(bool off);          /* bsd/dev/herolte_gl.c (0359) */
 extern "C" boolean_t mach_timer_coalescing_enabled;    /* osfmk/kern/timer_call.c, sysctl kern.timer_coalescing_enabled */
 #endif
 
@@ -1542,6 +1543,8 @@
 #if defined(ARM64_BOARD_CONFIG_HEROLTE)
 			/* (0330) the cores' rates follow it: bsd/dev/herolte_gpu.c, hg_power_thread */
 			herolte_screen_off_at = off ? mach_absolute_time() : 0;
+			/* (0359) the panel itself: asleep after the fade, awake again before this returns (bsd/dev/herolte_gl.c) */
+			herolte_panel_power(off);
 #endif
 			IOLog("SWEET FB: display %s\n", off ? "off" : "on");
 		}
