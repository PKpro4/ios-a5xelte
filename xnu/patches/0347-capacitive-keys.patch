diff --git a/bsd/dev/a5xelte_keys.c b/bsd/dev/a5xelte_keys.c
--- a/bsd/dev/a5xelte_keys.c
+++ b/bsd/dev/a5xelte_keys.c
@@ -77,6 +77,230 @@
 static const uint8_t a5_key_pins[4] = {7, 0, 1, 5};
 #endif
 
+#if defined(ARM64_BOARD_CONFIG_HEROLTE)
+/*
+ * (0347) the two capacitive keys below the screen: ABOV MC96FT16xx touch key IC at I2C 0x20 (stock DTB
+ * touchkey@20, i2c-gpio on GPE5 2 SDA / 3 SCL of pinctrl@14CC0000, bank 0x20 in Samsung's pinctrl-exynos.c;
+ * interrupt GPA0 0, active low; powered by TOUCH_VDD_3.3V, boot-on). Samsung's abov_touchkey.c: register 0x00
+ * reads the keys (bits 1:0 recents, 3:2 back; 2 = pressed, 1 = released) and takes the LED commands 0x10 on /
+ * 0x20 off. Bit-banged here like the camera's sensor bus: a line is released (input, the board's pull-up) or
+ * driven low (output 0). Left (recents): Home twice, iOS's app switcher. Right (back): a swipe in from the left
+ * edge, UIKit's "back" in navigation stacks (Settings, Safari, most apps). The light: on at a press, off 3 s later.
+ */
+extern void sweet_hid_touch(int finger, int down, int x, int y);
+#define TK_PINS_PA      0x14cc0000u
+#define TK_GPE5_CON     0x20u
+#define TK_GPE5_DAT     0x24u
+#define TK_SDA          2u
+#define TK_SCL          3u
+#define TK_ADDR         0x20u
+#define TK_FINGER       9               /* a finger the panel's own 10 rarely reach */
+static vm_offset_t tk_pins;
+static bool tk_ok;
+static bool tk_lit;
+static uint64_t tk_last_press;
+
+static void
+tk_msleep(unsigned ms)
+{
+	uint64_t deadline;
+	clock_interval_to_deadline(ms, NSEC_PER_MSEC, &deadline);
+	(void)assert_wait_deadline(&tk_pins, THREAD_UNINT, deadline);
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+static void
+tk_line(unsigned pin, int high)
+{
+	volatile uint32_t *con = (volatile uint32_t *)(tk_pins + TK_GPE5_CON);
+	uint32_t v = *con & ~(0xfu << (4 * pin));
+	*con = high ? v : (v | (1u << (4 * pin)));     /* input (pulled up) or output, DAT bit kept 0 */
+	__asm__ volatile("dsb sy" ::: "memory");
+	delay(5);
+	if (high && pin == TK_SCL) {
+		for (unsigned n = 0; n < 1000 && !((*(volatile uint32_t *)(tk_pins + TK_GPE5_DAT) >> TK_SCL) & 1); n++) {
+			delay(1);
+		}
+	}
+}
+
+static int
+tk_sda(void)
+{
+	return (int)((*(volatile uint32_t *)(tk_pins + TK_GPE5_DAT) >> TK_SDA) & 1);
+}
+
+static void
+tk_start(void)
+{
+	tk_line(TK_SDA, 1); tk_line(TK_SCL, 1); tk_line(TK_SDA, 0); tk_line(TK_SCL, 0);
+}
+
+static void
+tk_stop(void)
+{
+	tk_line(TK_SDA, 0); tk_line(TK_SCL, 1); tk_line(TK_SDA, 1);
+}
+
+static bool
+tk_out(uint8_t b)
+{
+	for (int i = 7; i >= 0; i--) {
+		tk_line(TK_SDA, (b >> i) & 1);
+		tk_line(TK_SCL, 1);
+		tk_line(TK_SCL, 0);
+	}
+	tk_line(TK_SDA, 1);
+	tk_line(TK_SCL, 1);
+	bool ack = !tk_sda();
+	tk_line(TK_SCL, 0);
+	return ack;
+}
+
+static uint8_t
+tk_in(bool ack)
+{
+	uint8_t b = 0;
+	tk_line(TK_SDA, 1);
+	for (int i = 7; i >= 0; i--) {
+		tk_line(TK_SCL, 1);
+		b = (uint8_t)(b << 1 | tk_sda());
+		tk_line(TK_SCL, 0);
+	}
+	tk_line(TK_SDA, ack ? 0 : 1);
+	tk_line(TK_SCL, 1);
+	tk_line(TK_SCL, 0);
+	tk_line(TK_SDA, 1);
+	return b;
+}
+
+static bool
+tk_read(uint8_t reg, uint8_t *v)
+{
+	tk_start();
+	bool ok = tk_out((uint8_t)(TK_ADDR << 1)) && tk_out(reg);
+	if (ok) {
+		tk_start();
+		ok = tk_out((uint8_t)(TK_ADDR << 1 | 1));
+		if (ok) {
+			*v = tk_in(false);
+		}
+	}
+	tk_stop();
+	return ok;
+}
+
+static bool
+tk_write(uint8_t reg, uint8_t v)
+{
+	tk_start();
+	bool ok = tk_out((uint8_t)(TK_ADDR << 1)) && tk_out(reg) && tk_out(v);
+	tk_stop();
+	return ok;
+}
+
+static void
+tk_light(bool on)
+{
+	if (tk_ok && tk_lit != on && tk_write(0x00, on ? 0x10 : 0x20)) {
+		tk_lit = on;
+	}
+}
+
+static void
+tk_pressed(void)
+{
+	tk_last_press = mach_absolute_time();
+	tk_light(true);
+}
+
+static void
+tk_init(void)
+{
+	tk_pins = ml_io_map(TK_PINS_PA, 0x1000);
+	if (!tk_pins) {
+		printf("HEROLTE TOUCHKEY: pin mapping failed\n");
+		return;
+	}
+	uint32_t con = *(volatile uint32_t *)(tk_pins + TK_GPE5_CON);
+	uint32_t dat = *(volatile uint32_t *)(tk_pins + TK_GPE5_DAT);
+	/* both lines released, their DAT bits 0 so that "output" means low */
+	*(volatile uint32_t *)(tk_pins + TK_GPE5_DAT) = dat & ~((1u << TK_SDA) | (1u << TK_SCL));
+	tk_line(TK_SDA, 1);
+	tk_line(TK_SCL, 1);
+	tk_stop();
+	uint8_t fw = 0, model = 0;
+	tk_ok = tk_read(0x01, &fw);
+	if (tk_ok) {
+		tk_read(0x14, &model);
+	}
+	printf("HEROLTE TOUCHKEY: GPE5 con %#x dat %#x (as found); ABOV at %#x %s: firmware %#x, model %#x\n", con, dat,
+	    TK_ADDR, tk_ok ? "answers" : "does NOT answer", fw, model);
+	if (tk_ok) {
+		tk_light(true);
+		tk_last_press = mach_absolute_time();
+	}
+}
+
+static void
+tk_back_swipe(void)
+{
+	/* in from the left edge (UIKit wants it within ~20 points), across to the middle in 160 ms, lifted there */
+	for (int step = 0; step <= 10; step++) {
+		sweet_hid_touch(TK_FINGER, 1, 8 + step * 90, 1280);
+		tk_msleep(16);
+	}
+	sweet_hid_touch(TK_FINGER, 0, 908, 1280);
+}
+
+static void
+tk_app_switcher(void)
+{
+	sweet_hid_key(3, 1);
+	tk_msleep(40);
+	sweet_hid_key(3, 0);
+	tk_msleep(80);
+	sweet_hid_key(3, 1);
+	tk_msleep(40);
+	sweet_hid_key(3, 0);
+}
+
+/* called every poll; gpa0 = the GPA0 DAT bits (the key IC's interrupt is bit 0, low while it has news) */
+static void
+tk_poll(uint16_t gpa0)
+{
+	if (!tk_ok) {
+		return;
+	}
+	if (!(gpa0 & 1u)) {
+		uint8_t s = 0;
+		if (tk_read(0x00, &s)) {
+			unsigned recents = s & 3u, back = (s >> 2) & 3u;
+			static unsigned logged;
+			if (logged++ < 20) {
+				printf("HEROLTE TOUCHKEY: status %#x (recents %u, back %u)\n", s, recents, back);
+			}
+			if (recents == 2 || back == 2) {
+				tk_pressed();
+			}
+			if (recents == 1) {
+				tk_app_switcher();
+			}
+			if (back == 1) {
+				tk_back_swipe();
+			}
+		}
+	}
+	if (tk_lit) {
+		uint64_t ns = 0;
+		absolutetime_to_nanoseconds(mach_absolute_time() - tk_last_press, &ns);
+		if (ns > 3000ull * NSEC_PER_MSEC) {
+			tk_light(false);
+		}
+	}
+}
+#endif
+
 static void
 a5_keys_thread(void *arg, wait_result_t result)
 {
@@ -85,6 +309,9 @@
 	unsigned repeated = 0;
 	(void)arg;
 	(void)result;
+#if defined(ARM64_BOARD_CONFIG_HEROLTE)
+	tk_init();
+#endif
 	for (;;) {
 		uint16_t sample = a5_keys_sample();
 		if (sample == previous) {
@@ -106,10 +333,18 @@
 						a5xelte_power_pressed_at = mach_absolute_time();
 					}
 					sweet_hid_key((int)key, down);
+#if defined(ARM64_BOARD_CONFIG_HEROLTE)
+					if (down) {
+						tk_pressed();   /* 0347: the keys' light comes on with Home/Power too */
+					}
+#endif
 				}
 			}
 			stable = sample;
 		}
+#if defined(ARM64_BOARD_CONFIG_HEROLTE)
+		tk_poll((uint16_t)(sample & 0xff));
+#endif
 		a5_keys_wait();
 	}
 }
