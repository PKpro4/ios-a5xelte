@@ -3963,12 +3963,13 @@
 	    (notefe_rd(alive, 0x64) >> 4) & 1, e2_con, e2_dat);
 	/*
 	 * 0357: boot-0356 read MCU_RESP 0 throughout, but gpg0-2 was never made an input: the stock DTB's ssp-mcu-resp is
-	 * function 0 (input) with pull-up (pud 3; 4-bit PUD fields, exynos5433 bank type). Set so here (put back at the
-	 * end). The chip is then taken out of standby from a clean low (20 ms), and HOST_REQ and MCU_RESP are watched every
-	 * ms for 300 ms: an edge = the ROM is alive.
+	 * function 0 (input) with pull-up (pud 3). Set so here (put back at the end). 0358: the PUD fields of this bank
+	 * are 2 bits (boot-0357: as found 0x17 = gpg0-2 pulled DOWN; the 4-bit write of 0357 missed it; TWRP's Linux reads
+	 * the pin high). The chip is then taken out of standby from a clean low (20 ms), and HOST_REQ and MCU_RESP are
+	 * watched every ms for 300 ms: an edge = the ROM is alive.
 	 */
 	uint32_t g0_con = notefe_rd(p, 0x140), g0_pud = notefe_rd(p, 0x148);
-	notefe_wr(p, 0x148, (g0_pud & ~(0xfu << 8)) | (0x3u << 8));
+	notefe_wr(p, 0x148, (g0_pud & ~(0x3u << 4)) | (0x3u << 4));
 	shub_pin(p, 0x140, 2, 0, -1);
 	delay(1000);
 	printf("HEROLTE SHUB: MCU_RESP gpg0-2 as found con %#x pud %#x; as input with pull-up now: %u\n", g0_con, g0_pud,
@@ -4122,6 +4123,33 @@
 	herolte_kthread_top(5000);
 }
 
+/*
+ * (0358) boot-0357: all ten power domains on with the screen off (~100-250 mA). Four of them hold blocks nothing here
+ * drives (BOOT DTB samsung,power-domain users: isp0 = fimc_is@14370000, isp1 = none, mfc = mfc0@152E0000, mscl =
+ * G2D/scalers; no patch maps their ranges): switched off once, for good (CONFIGURATION bits 3:0 = 0, STATUS awaited
+ * up to 10 ms). The current is read before and after (hs_currents). The camera, display, GPU and audio stay as they are.
+ */
+static void
+hs_unused_off(vm_offset_t pmu)
+{
+	static const uint32_t offs[] = { 0x4140, 0x4160, 0x4180, 0x4040 };
+	static const char *const names[] = { "isp0", "isp1", "mfc", "mscl" };
+	for (unsigned i = 0; i < 4; i++) {
+		uint32_t st = notefe_rd(pmu, offs[i] + 4) & 0xf;
+		if (st == 0) {
+			printf("HEROLTE SLEEP: %s already off\n", names[i]);
+			continue;
+		}
+		notefe_wr(pmu, offs[i], notefe_rd(pmu, offs[i]) & ~0xfu);
+		unsigned us = 0;
+		while ((notefe_rd(pmu, offs[i] + 4) & 0xf) != 0 && us < 10000) {
+			delay(10);
+			us += 10;
+		}
+		printf("HEROLTE SLEEP: %s off: status %#x after %u us\n", names[i], notefe_rd(pmu, offs[i] + 4) & 0xf, us);
+	}
+}
+
 static void
 hs_thread(__unused void *arg, __unused wait_result_t wr)
 {
@@ -4146,6 +4174,10 @@
 		seen = off;
 		rounds++;
 		hs_currents("screen off 30 s");
+		if (rounds == 1) {
+			hs_unused_off(pmu);
+			hs_currents("unused domains off");
+		}
 		hs_census(pmu, pins);
 		hs_currents("after census");
 	}
