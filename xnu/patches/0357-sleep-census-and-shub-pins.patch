+/* (0357, S7) the current now and averaged by the gauge (CURRENT 0x0a, AVGCURRENT 0x0b), mA, minus = from the battery */
+int
+herolte_fg_currents(int *now_ma, int *avg_ma)
+{
+	uint16_t c, a;
+	if (!fg_i2c || !fg_word(FG_CURRENT, &c) || !fg_word(0x0b, &a)) {
+		return -1;
+	}
+	*now_ma = (int)(((int64_t)(int16_t)c * 15625) / 100000);
+	*avg_ma = (int)(((int64_t)(int16_t)a * 15625) / 100000);
+	return 0;
+}
