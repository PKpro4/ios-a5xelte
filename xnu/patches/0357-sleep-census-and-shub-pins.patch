+/*
+ * (0357, S7) Where the power goes with the screen off. boot-0356: 61% to 0 in an hour, the gauge at -600 to -830 mA
+ * the whole time with every process near 0% (TOP all 20-30% of 800%) and the SoC at 32 C. Once per screen-off
+ * episode (30 s after it went off, four per boot): the gauge's current (now/average) 6 times 2 s apart, the ten
+ * power domains' STATUS (PMU 0x105C0000 + pd + 4, 0xf = on; BOOT DTB pd-* nodes), the S2MPS16's registers 0x10-0x7f
+ * (through the APM; 0x00-0x0f left alone: interrupt registers clear on read), the S2MPB02's 0x0b-0x2f, then the
+ * busiest kernel threads over 5 s (osfmk/kern/task.c) and the current again. Reads only.
+ */
+extern volatile uint64_t herolte_screen_off_at;
+extern int herolte_fg_currents(int *now_ma, int *avg_ma);
+extern bool herolte_apm_pmic_read(uint8_t reg, uint8_t *value);
+extern void herolte_kthread_top(uint32_t ms);
+
+static const struct { const char *name; uint32_t off; } hs_pd[] = {
+	{ "aud", 0x40c0 }, { "cam0", 0x4020 }, { "cam1", 0x40a0 }, { "disp0", 0x4080 }, { "g3d", 0x4060 },
+	{ "isp0", 0x4140 }, { "isp1", 0x4160 }, { "mfc", 0x4180 }, { "mscl", 0x4040 }, { "disp1", 0x41a0 },
+};
+
+static void
+hs_currents(const char *when)
+{
+	char line[160];
+	int o = 0;
+	line[0] = 0;
+	for (unsigned i = 0; i < 6; i++) {
+		int now = 0, avg = 0;
+		if (herolte_fg_currents(&now, &avg) == 0) {
+			o += snprintf(line + o, sizeof(line) - (size_t)o, " %d/%d", now, avg);
+		} else {
+			o += snprintf(line + o, sizeof(line) - (size_t)o, " -");
+		}
+		ns_sleep_ms(2000);
+	}
+	printf("HEROLTE SLEEP: %s: mA now/avg:%s\n", when, line);
+}
+
+static void
+hs_census(vm_offset_t pmu, vm_offset_t pins)
+{
+	char line[200];
+	int o = 0;
+	for (unsigned i = 0; i < sizeof(hs_pd) / sizeof(hs_pd[0]); i++) {
+		o += snprintf(line + o, sizeof(line) - (size_t)o, " %s=%x", hs_pd[i].name, notefe_rd(pmu, hs_pd[i].off + 4) & 0xf);
+	}
+	printf("HEROLTE SLEEP: power domains (f = on):%s\n", line);
+	for (unsigned r = 0x10; r < 0x80; r += 16) {
+		o = 0;
+		for (unsigned k = 0; k < 16; k++) {
+			uint8_t v = 0;
+			if (herolte_apm_pmic_read((uint8_t)(r + k), &v)) {
+				o += snprintf(line + o, sizeof(line) - (size_t)o, " %02x", v);
+			} else {
+				o += snprintf(line + o, sizeof(line) - (size_t)o, " --");
+			}
+		}
+		printf("HEROLTE SLEEP: S2MPS16 %02x:%s\n", r, line);
+	}
+	if (nc_i2c) {
+		nc_pins = pins;
+		NC_BANK = 0x140; NC_SDA = 2; NC_SCL = 3;
+		o = 0;
+		for (unsigned r = 0x0b; r <= 0x2f; r++) {
+			uint8_t v = 0;
+			if (nc_read(0x59, (uint8_t)r, &v, 1)) {
+				o += snprintf(line + o, sizeof(line) - (size_t)o, " %02x", v);
+			} else {
+				o += snprintf(line + o, sizeof(line) - (size_t)o, " --");
+			}
+		}
+		printf("HEROLTE SLEEP: S2MPB02 0b-2f:%s\n", line);
+	}
+	herolte_kthread_top(5000);
+}
+
+static void
+hs_thread(__unused void *arg, __unused wait_result_t wr)
+{
+	vm_offset_t pmu = ml_io_map(0x105c0000u, 0x5000), pins = ml_io_map(0x136d0000u, 0x1000);
+	uint64_t seen = 0;
+	unsigned rounds = 0;
+	if (!pmu || !pins) {
+		printf("HEROLTE SLEEP: map failed\n");
+		return;
+	}
+	printf("HEROLTE SLEEP: census 30 s into each screen-off (4 per boot)\n");
+	for (;;) {
+		ns_sleep_ms(1000);
+		uint64_t off = herolte_screen_off_at, ns = 0, now = mach_absolute_time();
+		if (off == 0 || off == seen || now < off || rounds >= 4) {
+			continue;
+		}
+		absolutetime_to_nanoseconds(now - off, &ns);
+		if (ns < 30ull * NSEC_PER_SEC) {
+			continue;
+		}
+		seen = off;
+		rounds++;
+		hs_currents("screen off 30 s");
+		hs_census(pmu, pins);
+		hs_currents("after census");
+	}
+}
+
+static void
+herolte_sleep_census_start(void)
+{
+	static bool started;
+	thread_t th;
+	if (started) {
+		return;
+	}
+	started = true;
+	if (kernel_thread_start(hs_thread, NULL, &th) == KERN_SUCCESS) {
+		thread_deallocate(th);
+	}
+}
