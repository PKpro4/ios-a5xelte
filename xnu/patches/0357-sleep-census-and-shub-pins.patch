diff --git a/osfmk/kern/task.c b/osfmk/kern/task.c
--- a/osfmk/kern/task.c
+++ b/osfmk/kern/task.c
@@ -9140,3 +9140,75 @@
 {
 	return kdp_lck_mtx_lock_spin_is_acquired(&task->lock);
 }
+
+#if defined(ARM64_BOARD_CONFIG_HEROLTE)
+/*
+ * (0357, S7) Which kernel threads use the CPU: "kernel_task 14%" stayed in every TOP line with the screen off
+ * (boot-0356; 7% on the first boot). Each kernel thread's run time over ms, the busiest six printed with their name,
+ * priority, continuation and the return addresses saved on their stack (three frames), plus this function's own
+ * address to undo the slide. Reads only.
+ */
+#define HKT_MAX 256
+void herolte_kthread_top(uint32_t ms);
+void
+herolte_kthread_top(uint32_t ms)
+{
+	static thread_t th_of[HKT_MAX];
+	static uint64_t t0[HKT_MAX], dt[HKT_MAX];
+	unsigned n = 0, total = 0;
+	thread_t th;
+	task_lock(kernel_task);
+	queue_iterate(&kernel_task->threads, th, thread_t, task_threads) {
+		total++;
+		if (n < HKT_MAX) {
+			thread_reference(th);
+			th_of[n] = th;
+			t0[n] = recount_thread_time_mach(th);
+			n++;
+		}
+	}
+	task_unlock(kernel_task);
+	uint64_t a0 = mach_absolute_time();
+	delay_for_interval(ms, NSEC_PER_MSEC);
+	uint64_t span = mach_absolute_time() - a0, sum = 0;
+	for (unsigned i = 0; i < n; i++) {
+		dt[i] = recount_thread_time_mach(th_of[i]) - t0[i];
+		sum += dt[i];
+	}
+	printf("HEROLTE KTOP: %u kernel threads, %llu%% of one core in all over %u ms (anchor herolte_kthread_top %p)\n",
+	    total, span ? sum * 100 / span : 0, ms, (void *)&herolte_kthread_top);
+	for (unsigned k = 0; k < 6; k++) {
+		unsigned best = HKT_MAX;
+		for (unsigned i = 0; i < n; i++) {
+			if (th_of[i] != THREAD_NULL && (best == HKT_MAX || dt[i] > dt[best])) {
+				best = i;
+			}
+		}
+		if (best == HKT_MAX || dt[best] == 0) {
+			break;
+		}
+		th = th_of[best];
+		char name[MAXTHREADNAMESIZE] = "";
+		thread_get_thread_name(th, name);
+		uint64_t lr[4] = { 0 };
+		if (th->kernel_stack) {
+			vm_offset_t lo = th->kernel_stack, hi = th->kernel_stack + kernel_stack_size;
+			thread_kernel_state_t ks = thread_get_kernel_state(th);
+			uint64_t fp = ks->machine.ss.fp;
+			lr[0] = ks->machine.ss.lr;
+			for (unsigned f = 1; f < 4 && fp >= lo && fp + 16 <= hi && (fp & 7) == 0; f++) {
+				lr[f] = ((uint64_t *)fp)[1];
+				fp = ((uint64_t *)fp)[0];
+			}
+		}
+		printf("HEROLTE KTOP: %llu%% tid %llu '%s' pri %d cont %p lr %#llx %#llx %#llx %#llx\n",
+		    span ? dt[best] * 100 / span : 0, thread_tid(th), name, th->sched_pri, (void *)th->continuation,
+		    lr[0], lr[1], lr[2], lr[3]);
+		dt[best] = 0;
+	}
+	for (unsigned i = 0; i < n; i++) {
+		thread_deallocate(th_of[i]);
+		th_of[i] = THREAD_NULL;
+	}
+}
+#endif
