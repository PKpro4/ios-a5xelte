 /*
+ * (0348, S7) TOUCH_VDD_3.3V, the capacitive keys' supply (a5xelte_keys.c, 0347): S2MPB02 LDO16 (L16CTRL 0x2d),
+ * "regulator-boot-on" in the stock DTB, 3.3 V fixed. Linux switches it on; under iOS nothing does (boot-0346: LDO16
+ * ctrl 0x6c, off) and the key IC never answered. 3.3 V = 600 mV + 108 x 25 mV = 0x6c. Returns 1 if switched on now,
+ * 0 if it was on, -1 if the PMIC does not answer.
+ */
+int herolte_touchkey_power(void);
+int
+herolte_touchkey_power(void)
+{
+	static vm_offset_t pins;
+	if (!nc_i2c) {
+		nc_i2c = ml_io_map(0x13680000u, 0x1000);
+	}
+	if (!pins) {
+		pins = ml_io_map(0x136d0000u, 0x1000);
+	}
+	if (!nc_i2c || !pins) {
+		printf("HEROLTE TOUCHKEY: power: map failed\n");
+		return -1;
+	}
+	uint32_t con = notefe_rd(pins, 0x40);
+	if (((con >> 16) & 0xf) != 2 || ((con >> 20) & 0xf) != 2) {
+		notefe_pin(pins, 0x40, 4, 2, -1, -1);   /* gpd1-4/5: HSI2C9, the S2MPB02's bus, as notefe_cam_probe does */
+		notefe_pin(pins, 0x40, 5, 2, -1, -1);
+	}
+	nc_bus_init();
+	uint8_t l16 = 0, now = 0;
+	if (!nc_read(0x59, 0x2d, &l16, 1)) {
+		printf("HEROLTE TOUCHKEY: power: the S2MPB02 does not answer\n");
+		return -1;
+	}
+	if ((l16 & 0x80) && (l16 & 0x7f) == 0x6c) {
+		printf("HEROLTE TOUCHKEY: power: TOUCH_VDD_3.3V (LDO16) already on (%#x)\n", l16);
+		return 0;
+	}
+	bool ok = nc_pmic_write(0x2d, 0x80 | 0x6c);
+	nc_read(0x59, 0x2d, &now, 1);
+	printf("HEROLTE TOUCHKEY: power: TOUCH_VDD_3.3V (LDO16) %#x -> %#x %s\n", l16, now, ok ? "on" : "FAILED");
+	return ok ? 1 : -1;
+}
+
+/*
  * Note FE (0444): camera stage 4, read only (kern.notefe_cam=4): what CSIS2 (the front's MIPI receiver, 0x14100000, in
  * CAM1) needs and how it is found. CMU_TOP ACLK_CAM1_CSIS2_414 (mux 0x2e8, div 0x448, enable 0x8a8); CMU_CAM1
  * (0x145d0000) the user muxes (BUS_264 0x20c, CSIS2_414 0x214, RXBYTECLKHS0_CSIS2 0x22c) and gates (BUS_264 0x814 bit 3
diff --git a/bsd/dev/a5xelte_keys.c b/bsd/dev/a5xelte_keys.c
