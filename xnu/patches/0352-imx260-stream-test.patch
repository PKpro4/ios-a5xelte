+/*
+ * (0352, S7) does the rear IMX260 stream? Its registers from the drop zone (cam/imx260.tab: "S7T1", u32 count, then
+ * u16 addr, u16 value, u8 width, 3 bytes 0 each; made from the phone's own Samsung ISP firmware, never in this repo:
+ * the global init and the 2016x1512 mode), then mode_select 0x0100 = 1, and the frame counter 0x0005 read every 100 ms:
+ * it counts only while frames go out. Stream off (0x0100 = 0) at the end. The receiver side (Companion, CSIS0) is next.
+ */
+#define NC_IMX          0x1a
+#define NC_IMX_TAB      "/private/var/herolte/cam/imx260.tab"
+
+static bool
+nc_imx_w(uint16_t reg, uint16_t v, unsigned width)
+{
+	nc_start();
+	bool ok = nc_byte_out((uint8_t)(NC_IMX << 1)) && nc_byte_out((uint8_t)(reg >> 8)) && nc_byte_out((uint8_t)reg) &&
+	    (width != 2 || nc_byte_out((uint8_t)(v >> 8))) && nc_byte_out((uint8_t)v);
+	nc_stop();
+	return ok;
+}
+
+static uint8_t
+nc_imx_r8(uint16_t reg)
+{
+	uint8_t v = 0xff;
+	nc_sensor_read(NC_IMX, reg, &v, 1);
+	return v;
+}
+
+static void
+nc_imx_stream_test(void)
+{
+	uint32_t len = 0;
+	uint8_t *tab = nc_drop_read(NC_IMX_TAB, &len);
+	if (tab == NULL) {
+		return;
+	}
+	uint32_t n = len >= 8 ? *(uint32_t *)(void *)(tab + 4) : 0;
+	if (len < 8 || memcmp(tab, "S7T1", 4) != 0 || n == 0 || 8 + 8ull * n > len) {
+		printf("NOTEFE CAM: rear: %s: not a table (%u bytes)\n", NC_IMX_TAB, len);
+		kfree_data(tab, NC_COMP_FW_MAX);
+		return;
+	}
+	uint8_t id[2] = { 0, 0 };
+	nc_sensor_read(NC_IMX, 0x0016, id, 2);
+	uint64_t t0 = mach_absolute_time();
+	uint32_t failed = 0;
+	for (uint32_t i = 0; i < n; i++) {
+		const uint8_t *e = tab + 8 + 8 * i;
+		uint16_t reg = (uint16_t)(e[0] | e[1] << 8), v = (uint16_t)(e[2] | e[3] << 8);
+		unsigned width = e[4];
+		if (!nc_imx_w(reg, v, width) && !nc_imx_w(reg, v, width)) {
+			if (failed++ < 8) {
+				printf("NOTEFE CAM: rear: IMX260 write %#06x = %#x (w%u) failed\n", reg, v, width);
+			}
+		}
+	}
+	kfree_data(tab, NC_COMP_FW_MAX);
+	uint64_t ns = 0;
+	absolutetime_to_nanoseconds(mach_absolute_time() - t0, &ns);
+	printf("NOTEFE CAM: rear: IMX260 (model %#06x): %u registers written, %u failed, %llu ms; W %u H %u FLL %u LLP %u\n",
+	    id[0] << 8 | id[1], n, failed, ns / 1000000ull, nc_imx_r8(0x034c) << 8 | nc_imx_r8(0x034d),
+	    nc_imx_r8(0x034e) << 8 | nc_imx_r8(0x034f), nc_imx_r8(0x0340) << 8 | nc_imx_r8(0x0341),
+	    nc_imx_r8(0x0342) << 8 | nc_imx_r8(0x0343));
+	uint8_t before = nc_imx_r8(0x0005);
+	bool on = nc_imx_w(0x0100, 0x01, 1);
+	char counts[96];
+	int o = 0;
+	for (unsigned k = 0; k < 8; k++) {
+		delay(100000);
+		o += snprintf(counts + o, sizeof(counts) - (size_t)o, " %u", nc_imx_r8(0x0005));
+	}
+	uint8_t mode = nc_imx_r8(0x0100);
+	nc_imx_w(0x0100, 0x00, 1);
+	delay(50000);
+	printf("NOTEFE CAM: rear: IMX260 stream on %s (0x0100 = %#x); frame count before %u, every 100 ms:%s; stream off\n",
+	    on ? "written" : "NOT written", mode, before, counts);
+}
